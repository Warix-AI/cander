{
  "name": "cander-desktop",
  "version": "0.1.2",
  "private": true,
  "description": "Cander macOS desktop shell",
  "main": "src/main.js",
  "author": "Warix AI",
  "scripts": {
    "prepare-dev-app": "node scripts/prepare-dev-app.js",
    "build:fm-helper": "node scripts/build-fm-helper.js",
    "dev": "node scripts/prepare-dev-app.js && env -u ELECTRON_RUN_AS_NODE CANDER_URL=http://localhost:3000 .dev/Cander.app/Contents/MacOS/Electron .",
    "start": "node scripts/prepare-dev-app.js && env -u ELECTRON_RUN_AS_NODE .dev/Cander.app/Contents/MacOS/Electron .",
    "pack": "npm run build:fm-helper && env -u ELECTRON_RUN_AS_NODE electron-builder --dir",
    "dist": "npm run build:fm-helper && env -u ELECTRON_RUN_AS_NODE electron-builder --mac dmg",
    "dist:unsigned": "npm run build:fm-helper && env -u ELECTRON_RUN_AS_NODE CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg",
    "postinstall": "node scripts/ensure-electron.js"
  },
  "build": {
    "appId": "ai.warix.cander",
    "productName": "Cander",
    "copyright": "Copyright © Warix AI",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/FoundationModelsHelper/FoundationModelsHelper",
        "to": "FoundationModelsHelper/FoundationModelsHelper"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "target": [
        "dmg"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "Cander"
    }
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  }
}
