# Supabase (required when NEXT_PUBLIC_DATA_BACKEND=supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — Edge Functions, account delete API, migrations, admin tasks
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (required for paid onboarding checkout)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_PRO=
STRIPE_PRICE_MAX=

# Optional — org invite emails (falls back to logging invite URLs in dev)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# local = mock data + localStorage (default)
# supabase = Supabase Auth + Postgres (all adapters)
NEXT_PUBLIC_DATA_BACKEND=local
