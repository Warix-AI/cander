# Supabase (required for live auth + data on localhost and production)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — Edge Functions, account delete API, migrations, admin tasks
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (required for paid onboarding checkout)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_PRO=
STRIPE_PRICE_MAX=

# Optional — org invite emails (falls back to logging invite URLs in dev)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional. Omit to use Supabase whenever URL + anon key are set.
# local = mock catalog (no live accounts)
NEXT_PUBLIC_DATA_BACKEND=supabase

# ── Private AI chat (server / Edge / Mac bridge only — never NEXT_PUBLIC) ──
# Edge Function secrets: CANDER_AI_BRIDGE_URL must be the Cloudflare Tunnel
# HTTPS hostname. Hosted Edge cannot reach 127.0.0.1 or private LAN addresses.
# CANDER_AI_BRIDGE_URL=https://<tunnel-hostname>
# CANDER_AI_BRIDGE_SECRET=
# BRAVE_SEARCH_API_KEY=   # Emergency rollback only when WEB_RESEARCH_PROVIDER=brave
#                          # Set via: npx supabase secrets set BRAVE_SEARCH_API_KEY=...
#
# ── Web research (Exa) — Edge Function secrets only; never NEXT_PUBLIC_ ──
# .env.local does NOT configure deployed Supabase Edge Functions.
# Apply with: npx supabase secrets set KEY=value
# EXA_API_KEY=                 # Required for Exa Search + Contents
# WEB_RESEARCH_ENABLED=true
# WEB_RESEARCH_PROVIDER=exa    # exa | brave (brave never auto-reactivates on Exa failure)
# EXA_DEEP_SEARCH_ENABLED=false  # Separate research endpoint; keep off
# WEB_RETRIEVAL_MODE=deep_only     # Ignored for now — normal chat hardcodes Exa type=deep
# NEXT_PUBLIC_WEB_RETRIEVAL_MODE=deep_only
# NEXT_PUBLIC_CANDER_WEB_MODE=off  # auto|on|off — default off (block web unless explicit browse)
# WEB_OPEN_DIRECT_FETCH_ENABLED=false  # Emergency legacy SSRF fetch only
# INFERENCE_PROVIDER=ollama   # Edge ModelProvider registry key (ollama only for now)
# AI_ORCHESTRATOR_V2=1        # Edge: bounded autonomous loop (default on). Set 0 for V1.
# NEXT_PUBLIC_AI_ORCHESTRATOR_V2=1  # Client prefers v2; set 0 to force v1 requests
# OLLAMA_CONTROLLER_MODEL=    # optional purpose override (defaults to OLLAMA_MODEL)
# OLLAMA_ANSWER_MODEL=        # optional purpose override
# NEXT_PUBLIC_AI_AGENT_ORCHESTRATOR=1   # 1/default = Edge TurnOrchestrator; 0 = legacy client agent
# Optional vision model for image questions (Mac bridge):
# OLLAMA_VISION_MODEL=llava
#
# Mac bridge only (services/cander-ai-bridge):
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2
# BRIDGE_HOST=127.0.0.1
# BRIDGE_PORT=8787
# BRIDGE_RATE_LIMIT_PER_MIN=30
# BRIDGE_MAX_BODY_BYTES=8388608
# See docs/runbook/ai-bridge.md

# ── Raw OpenAI benchmark mode (temporary A/B vs V6; default ON) ──
# Server-only secret — NEVER use NEXT_PUBLIC_OPENAI_API_KEY
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-luna
# OPENAI_WEB_SEARCH=1            # native Responses API web_search (model decides when)
# OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
# OPENAI_IMAGE_GENERATION=1      # Responses image_generation tool
# OPENAI_IMAGE_MODEL=gpt-image-1.5
# OPENAI_IMAGE_QUALITY=medium
# RAW_OPENAI_MODE=1              # opt in to raw OpenAI benchmark mode (bypasses V6)
# NEXT_PUBLIC_RAW_OPENAI_MODE=1  # client-side opt in to raw mode

# ── Usage protection (server-only) ──
# USAGE_ENFORCEMENT_ENABLED=true   # default on; set false/0/off to bypass in emergencies

# ── Composio connector phase (server-only) ──
# COMPOSIO_API_KEY=
# COMPOSIO_KEY=                 # alternate name if COMPOSIO_API_KEY is unavailable
# COMPOSIO_WEBHOOK_SECRET=
# COMPOSIO_GMAIL_AUTH_CONFIG_ID=
# COMPOSIO_GCAL_AUTH_CONFIG_ID=   # Google Calendar auth config id (ac_…) from Composio
# COMPOSIO_GDRIVE_AUTH_CONFIG_ID= # Google Drive auth config id (ac_…) from Composio
# COMPOSIO_GSHEETS_AUTH_CONFIG_ID= # Google Sheets auth config id (ac_…) from Composio
# COMPOSIO_GDOCS_AUTH_CONFIG_ID=   # Google Docs auth config id (ac_…) from Composio
# COMPOSIO_SLACK_AUTH_CONFIG_ID=
# COMPOSIO_OUTLOOK_AUTH_CONFIG_ID=
# COMPOSIO_NOTION_AUTH_CONFIG_ID=
# COMPOSIO_HUBSPOT_AUTH_CONFIG_ID=
# COMPOSIO_GITHUB_AUTH_CONFIG_ID=
# COMPOSIO_TEAMS_AUTH_CONFIG_ID=
# COMPOSIO_STRIPE_AUTH_CONFIG_ID=
# COMPOSIO_SALESFORCE_AUTH_CONFIG_ID=
# COMPOSIO_LINEAR_AUTH_CONFIG_ID=
# COMPOSIO_JIRA_AUTH_CONFIG_ID=
# COMPOSIO_SHOPIFY_AUTH_CONFIG_ID= # requires custom Shopify OAuth client in Composio first
# COMPOSIO_CALLBACK_VERIFIER_URL=https://<host>/api/connectors/oauth/verify

# Unified agent runtime (server-only). Defaults to v2 when unset.
# Opt out with AI_AGENT_RUNTIME=legacy
# AI_AGENT_RUNTIME=v2
# MAX_DISCOVERED_TOOLS=15
# AI_AGENT_MAX_ITERATIONS=6
# See docs/connectors/composio-integration.md
# USAGE_KILL_SWITCH_GLOBAL=1       # emergency platform-wide block
# USAGE_GLOBAL_DAILY_CEILING_MICROS=100000000
# USAGE_GLOBAL_MONTHLY_CEILING_MICROS=1000000000

# ── Vercel Sandbox + agent-browser (Computer / Phase 1.5+) ──
# AGENT_BROWSER_SNAPSHOT_ID=   # Pre-built sandbox snapshot for sub-second boot
# VERCEL_TOKEN=                # PAT that can create projects on the Warix team (Sandbox + Deployments). teamId is always sent as ?teamId=.
# VERCEL_TEAM_ID=              # Warix Vercel team id (team_…)
# VERCEL_PROJECT_ID=           # Cander platform project (not per-tenant apps)
# COMPUTER_DEV_USER_ID=   # Local spike testing: your Supabase profile UUID (when not signed in)

# ── Build infra (Warix-managed GitHub / Vercel / Supabase for Apps & Websites) ──
# Users do NOT connect their own GitHub/Vercel/Supabase for Build.
# All provisioning uses these server-only credentials via Octokit / REST SDKs.
# See docs/runbook/build-infra.md
#
# GitHub App installed on the Warix org (create private repos + push):
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=      # PEM with \n escapes, or base64-encoded PEM
# GITHUB_APP_INSTALLATION_ID=
# GITHUB_APP_ORG=Warix-AI
# GITHUB_APP_TEMPLATE_REPO=    # optional owner/name template for generate
#
# Commit author for draft/publish (REQUIRED for production Publish).
# Must be a GitHub identity that belongs to the Warix Vercel team — otherwise
# publish preflight fails and/or Vercel shows Blocked / GitHub user not found.
# Do NOT rely on the github-actions[bot] default.
# CANDER_BUILD_GIT_AUTHOR_NAME=mattxgross
# CANDER_BUILD_GIT_AUTHOR_EMAIL=12345678+mattxgross@users.noreply.github.com
#
# Enable Build AI → sandbox → GitHub draft path (Phase 3):
# CANDER_BUILD_SANDBOX=1
# NEXT_PUBLIC_CANDER_BUILD_SANDBOX=1

# Builder jobs run inside the project sandbox and call back to this app for
# LLM / 21st proxying (secrets stay server-side). Set to your public URL:
# CANDER_BUILDER_CALLBACK_URL=https://app.example.com
# Optional overrides:
# CANDER_BUILD_JOB_SECRET=            # HMAC secret for per-job tokens (defaults to a derivation of the service-role key)
# CANDER_BUILDER_REASONING=medium     # low | medium | high
# CANDER_BUILDER_TRANSPORT=direct     # local dev only: ship OPENAI_API_KEY into the sandbox instead of proxying
# OPENAI_WEB_SEARCH=1                 # let the planner research with web_search
#
# 21st.dev MCP (server-only — never NEXT_PUBLIC_). Guided website create retrieval.
# Get a key at https://21st.dev/mcp or https://21st.dev/settings/api-keys
# Smoke: API_KEY_21ST=… npx tsx scripts/test-21st-mcp.ts
# API_KEY_21ST=
# TWENTY_FIRST_API_KEY=   # alias for API_KEY_21ST
# NEXT_PUBLIC_AI_BUILD_21ST=1  # optional: enable 21st in bounded component search UI
# Supabase Management API (per-app projects — Phase 4):
# SUPABASE_MANAGEMENT_ACCESS_TOKEN=   # personal access token or fine-grained token
# SUPABASE_MANAGEMENT_ORG_ID=         # org id or slug
# SUPABASE_MANAGEMENT_ORG_SLUG=       # preferred org slug for create project
# SUPABASE_MANAGEMENT_REGION_GROUP=americas
# SUPABASE_MANAGEMENT_INSTANCE_SIZE=micro
#
# (Legacy aliases also accepted: SUPABASE_ACCESS_TOKEN, SUPABASE_ORG_ID)
