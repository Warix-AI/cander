# Supabase (required for live auth + data on localhost and production)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — Edge Functions, account delete API, migrations, admin tasks
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (required for paid onboarding checkout)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_PRO=
STRIPE_PRICE_MAX=

# Optional — org invite emails (falls back to logging invite URLs in dev)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional. Omit to use Supabase whenever URL + anon key are set.
# local = mock catalog (no live accounts)
NEXT_PUBLIC_DATA_BACKEND=supabase

# ── Private AI chat (server / Edge / Mac bridge only — never NEXT_PUBLIC) ──
# Edge Function secrets: CANDER_AI_BRIDGE_URL must be the Cloudflare Tunnel
# HTTPS hostname. Hosted Edge cannot reach 127.0.0.1 or private LAN addresses.
# CANDER_AI_BRIDGE_URL=https://<tunnel-hostname>
# CANDER_AI_BRIDGE_SECRET=
# BRAVE_SEARCH_API_KEY=   # Emergency rollback only when WEB_RESEARCH_PROVIDER=brave
#                          # Set via: npx supabase secrets set BRAVE_SEARCH_API_KEY=...
#
# ── Web research (Exa) — Edge Function secrets only; never NEXT_PUBLIC_ ──
# .env.local does NOT configure deployed Supabase Edge Functions.
# Apply with: npx supabase secrets set KEY=value
# EXA_API_KEY=                 # Required for Exa Search + Contents
# WEB_RESEARCH_ENABLED=true
# WEB_RESEARCH_PROVIDER=exa    # exa | brave (brave never auto-reactivates on Exa failure)
# EXA_DEEP_SEARCH_ENABLED=false  # Separate research endpoint; keep off
# WEB_RETRIEVAL_MODE=deep_only     # Ignored for now — normal chat hardcodes Exa type=deep
# NEXT_PUBLIC_WEB_RETRIEVAL_MODE=deep_only
# NEXT_PUBLIC_CANDER_WEB_MODE=off  # auto|on|off — default off (block web unless explicit browse)
# WEB_OPEN_DIRECT_FETCH_ENABLED=false  # Emergency legacy SSRF fetch only
# INFERENCE_PROVIDER=ollama   # Edge ModelProvider registry key (ollama only for now)
# AI_ORCHESTRATOR_V2=1        # Edge: bounded autonomous loop (default on). Set 0 for V1.
# NEXT_PUBLIC_AI_ORCHESTRATOR_V2=1  # Client prefers v2; set 0 to force v1 requests
# OLLAMA_CONTROLLER_MODEL=    # optional purpose override (defaults to OLLAMA_MODEL)
# OLLAMA_ANSWER_MODEL=        # optional purpose override
# NEXT_PUBLIC_AI_AGENT_ORCHESTRATOR=1   # 1/default = Edge TurnOrchestrator; 0 = legacy client agent
# Optional vision model for image questions (Mac bridge):
# OLLAMA_VISION_MODEL=llava
#
# Mac bridge only (services/cander-ai-bridge):
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2
# BRIDGE_HOST=127.0.0.1
# BRIDGE_PORT=8787
# BRIDGE_RATE_LIMIT_PER_MIN=30
# BRIDGE_MAX_BODY_BYTES=8388608
# See docs/runbook/ai-bridge.md

# ── Raw OpenAI benchmark mode (temporary A/B vs V6; default ON) ──
# Server-only secret — NEVER use NEXT_PUBLIC_OPENAI_API_KEY
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-luna
# OPENAI_WEB_SEARCH=1            # native Responses API web_search (model decides when)
# OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
# OPENAI_IMAGE_GENERATION=1      # Responses image_generation tool
# OPENAI_IMAGE_MODEL=gpt-image-1.5
# OPENAI_IMAGE_QUALITY=medium
# RAW_OPENAI_MODE=0              # set 0 to disable raw mode on server
# NEXT_PUBLIC_RAW_OPENAI_MODE=0  # set 0 to restore V6/Apple in the browser

# ── Usage protection (server-only) ──
# USAGE_ENFORCEMENT_ENABLED=true   # default on; set false/0/off to bypass in emergencies

# ── Composio connector phase (server-only) ──
# COMPOSIO_API_KEY=
# COMPOSIO_KEY=                 # alternate name if COMPOSIO_API_KEY is unavailable
# COMPOSIO_WEBHOOK_SECRET=
# COMPOSIO_GMAIL_AUTH_CONFIG_ID=
# COMPOSIO_CALLBACK_VERIFIER_URL=https://<host>/api/connectors/oauth/verify
# See docs/connectors/composio-integration.md
# USAGE_KILL_SWITCH_GLOBAL=1       # emergency platform-wide block
# USAGE_GLOBAL_DAILY_CEILING_MICROS=100000000
# USAGE_GLOBAL_MONTHLY_CEILING_MICROS=1000000000

# ── Vercel Sandbox + agent-browser (Computer / Phase 1.5+) ──
# AGENT_BROWSER_SNAPSHOT_ID=   # Pre-built sandbox snapshot for sub-second boot
# VERCEL_TOKEN=                # Local dev only; OIDC is automatic on Vercel deploy
# VERCEL_TEAM_ID=
# VERCEL_PROJECT_ID=
# COMPUTER_DEV_USER_ID=   # Local spike testing: your Supabase profile UUID (when not signed in)
