{
  "name": "cander",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:migrations": "bash scripts/check-migrations.sh",
    "test:security": "node --experimental-strip-types --test scripts/security-denial.test.ts",
    "seed:supabase": "node --experimental-strip-types scripts/seed.ts 2>/dev/null || npx --yes tsx scripts/seed.ts",
    "desktop": "npm --prefix desktop run dev",
    "desktop:prod": "npm --prefix desktop run start",
    "desktop:dev": "npm --prefix desktop run dev",
    "desktop:dmg": "npm --prefix desktop run dist:unsigned",
    "mobile:sync": "npm --prefix mobile run sync:prod",
    "mobile:sync:dev": "npm --prefix mobile run sync:dev",
    "mobile:ios": "npm --prefix mobile run ios",
    "mobile:ios:dev": "npm --prefix mobile run ios:dev",
    "mobile:android": "npm --prefix mobile run android",
    "mobile:android:dev": "npm --prefix mobile run android:dev"
  },
  "dependencies": {
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.8",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "stripe": "^22.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
